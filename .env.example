# ── Cyber Incident Reporting Portal Environment Configuration ──────
SECRET_KEY=cyber-incident-portal-secret-key-change-me
PORTAL_BASE_URL=http://localhost:5000

# ── Email (SMTP) Settings ───────────────────────────────────────────
# Fill these in to enable automated status update emails to citizens.

# Example for Gmail:
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-16-character-app-password
MAIL_DEFAULT_SENDER=your-email@gmail.com

# Example for Outlook / Hotmail:
# MAIL_SERVER=smtp-mail.outlook.com
# MAIL_PORT=587
# MAIL_USE_TLS=true
# MAIL_USE_SSL=false
# MAIL_USERNAME=your-email@outlook.com
# MAIL_PASSWORD=your-password
# MAIL_DEFAULT_SENDER=your-email@outlook.com
