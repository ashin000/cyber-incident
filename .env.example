# ── Cyber Incident Reporting Portal — Environment Configuration ─────
# Copy this file to .env and fill in your values.
# On Render: set these in Dashboard → Environment (never commit real secrets).

# ── Flask ─────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string
PORTAL_BASE_URL=https://cyber-incident-portal.onrender.com

# ── Paths (Render Persistent Disk — set automatically via render.yaml) ─
# DATABASE_PATH=/opt/render/data/cyber_incident_portal.db
# UPLOAD_FOLDER=/opt/render/data/uploads
# REPORTS_FOLDER=/opt/render/data/reports

# ── Email (SMTP) Settings ─────────────────────────────────────────────
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-16-character-app-password
MAIL_DEFAULT_SENDER=your-email@gmail.com

# ── Local development overrides ───────────────────────────────────────
# DATABASE_PATH=cyber_incident_portal.db   (defaults to project root)
# PORTAL_BASE_URL=http://localhost:5000
